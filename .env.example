# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify — theme image uploads (Files CDN) + future product sync
# Store URL without https:// (e.g. your-store.myshopify.com)
SHOPIFY_STORE_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-07
# Main navigation handle in Shopify (default: main-menu)
# SHOPIFY_MAIN_MENU_HANDLE=main-menu

# Optional: use a permanent Admin API access token instead of client credentials
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...

# Legacy names (also supported if already in .env.local):
# Shopify_Store_URL=
# Shopify_Store_Client_ID=
# Shopify_Store_Client_Secret=
# API_version=
