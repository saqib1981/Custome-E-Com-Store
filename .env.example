# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# /myadmin login uses Supabase Authentication → Users (email + password).
# Add admins in Dashboard → Authentication → Users. No extra table required.

# Shopify — theme image uploads (Files CDN) + navigation menus
# Store URL without https:// (e.g. your-store.myshopify.com)
SHOPIFY_STORE_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-07
# Main navigation handle when admin has not picked a menu yet (default: main-menu)
SHOPIFY_MAIN_MENU_HANDLE=main-menu

# Optional: permanent Admin API access token instead of client credentials
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
# Dev Dashboard apps usually do NOT show a permanent Admin token — Client ID + Secret
# are enough. This app requests Admin tokens via client_credentials automatically.

# Optional Storefront API token override for /account login.
# If unset, the app creates/reuses a Storefront token via Admin API
# (enable Storefront / unauthenticated scopes on the app, release + reinstall).
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional public site URL (required for Shopify email OTP callback in production)
# Example: https://www.yourstore.com
NEXT_PUBLIC_APP_URL=https://atonespot.com.pk

# Customer Account API (Headless sales channel → Customer Account API credentials).
# Public web-app client ID only — separate from Admin SHOPIFY_CLIENT_ID above.
# Customer Account API credentials fron Headless sales channel Client ID.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Legacy: Shopify_Customer_Account_Client_ID=

# Required Dev Dashboard access scopes for EVERY store you connect:
#   read_online_store_navigation  (header / mobile menus)
#   write_files                   (logo & favicon uploads)
# After enabling scopes: release a new app version, then install/approve on the store.

# Legacy names (also supported if already in .env.local):
# Shopify_Store_URL=
# Shopify_Store_Client_ID=
# Shopify_Store_Client_Secret=
# API_version=
