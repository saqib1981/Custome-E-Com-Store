# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify — theme image uploads (Files CDN) + navigation menus
# Store URL without https:// (e.g. your-store.myshopify.com)
SHOPIFY_STORE_URL=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-07
# Main navigation handle when admin has not picked a menu yet (default: main-menu)
# SHOPIFY_MAIN_MENU_HANDLE=main-menu

# Optional: permanent Admin API access token instead of client credentials
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...

# Required Dev Dashboard access scopes for EVERY store you connect:
#   read_online_store_navigation  (header / mobile menus)
#   write_files                   (logo & favicon uploads)
# After enabling scopes: release a new app version, then install/approve on the store.

# Legacy names (also supported if already in .env.local):
# Shopify_Store_URL=
# Shopify_Store_Client_ID=
# Shopify_Store_Client_Secret=
# API_version=
